# API mode: "mock" (in-browser, default) or "real" (fetch to backend)
VITE_API_MODE=mock
# Backend REST base URL (real mode)
VITE_API_BASE_URL=http://localhost:8080
# WebSocket URL (real mode)
VITE_WS_URL=ws://localhost:8080/ws
# API key (real mode): отправляется как заголовок X-API-Key (blockers #9)
VITE_API_KEY=
