# API mode: "mock" (in-browser, default) or "real" (REST + WS через Vite-прокси в dev)
VITE_API_MODE=mock
# REST base URL. Пусто = same-origin (dev: Vite-прокси → BACKEND_URL, default http://localhost:8080)
VITE_API_BASE_URL=
# WebSocket URL. Пусто = ws(s)://<current-origin>/ws
VITE_WS_URL=
# API key: отправляется как заголовок X-API-Key (лид-решение, _workspace/blockers.md #9)
VITE_API_KEY=
